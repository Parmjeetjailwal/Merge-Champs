// Prisma schema for the QA Management Application (SQLite for local dev).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  team      String?
  role      String   @default("Team Member") // Admin | QA Lead | Call QA Analyst | Team Member
  createdAt DateTime @default(now())

  timeRecords     TimeUtilizationRecord[]
  qaScores        QAScore[]             @relation("AgentScores")
  evaluatedScores QAScore[]             @relation("Evaluator")
  maintenance     MaintenanceActivity[]
  qcCallHandled   CallQcEvaluation[]    @relation("CallHandler")
  qcCaseOwned     CallQcEvaluation[]    @relation("CaseOwner")
  qcAnalyzed      CallQcEvaluation[]    @relation("QcAnalyst")
}

model TimeUtilizationRecord {
  id                 String   @id @default(cuid())
  employee           Employee @relation(fields: [employeeId], references: [id])
  employeeId         String
  period             String // e.g. 2026-06
  plannedHours       Float
  actualHours        Float
  utilizationPercent Float
  sourceFile         String?
  uploadedAt         DateTime @default(now())

  @@unique([employeeId, period])
}

model QAScore {
  id                 String    @id @default(cuid())
  agent              Employee  @relation("AgentScores", fields: [employeeId], references: [id])
  employeeId         String
  jiraTicketKey      String
  timelinessScore    Float
  documentationScore Float
  totalScore         Float
  evaluationDate     DateTime  @default(now())
  period             String // YYYY-MM
  evaluator          Employee? @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluatorId        String?
  comments           String?
}

model QAReport {
  id            String   @id @default(cuid())
  period        String
  generatedAt   DateTime @default(now())
  exportedToPMI Boolean  @default(false)
  pmiReference  String?
  payload       String // JSON string of the PMI export
}

model Joinee {
  id        String    @id @default(cuid())
  name      String
  joinDate  DateTime
  team      String?
  mentor    String?
  createdAt DateTime  @default(now())
  topics    KTTopic[]
  accesses  JoineeAccess[]
}

model KTTopic {
  id            String    @id @default(cuid())
  joinee        Joinee    @relation(fields: [joineeId], references: [id], onDelete: Cascade)
  joineeId      String
  topicName     String
  status        String    @default("Pending") // Pending | Completed
  completedDate DateTime?
  targetDate    DateTime?
  notes         String?
  signedOffBy   String?
}

model MaintenanceActivity {
  id                String   @id @default(cuid())
  title             String
  employee          Employee @relation(fields: [employeeId], references: [id])
  employeeId        String
  scheduledStart    DateTime
  scheduledEnd      DateTime
  actualStart       DateTime
  actualEnd         DateTime
  status            String // WithinTime | Exceeded
  exceededByMinutes Int      @default(0)
  month             String // YYYY-MM
  createdAt         DateTime @default(now())
}

// Reference data: the QC scorecard parameters (Call Handling + Case Handling).
model QcParameter {
  id       String         @id @default(cuid())
  code     String         @unique // QC1..QC20
  section  String // CALL | CASE
  text     String
  order    Int
  active   Boolean        @default(true)
  critical Boolean        @default(false) // a "No" on a critical parameter auto-fails the QC
  answers  CallQcAnswer[]
}

// One Call or Case QC evaluation for a single case. `kind` selects which scorecard it belongs to.
model CallQcEvaluation {
  id                    String    @id @default(cuid())
  kind                  String    @default("CALL") // CALL | CASE
  srNo                  Int?
  product               String?
  caseNo                String
  callDateTime          DateTime?
  ticketCreatedDateTime DateTime?
  userName              String?

  callHandledBy   Employee? @relation("CallHandler", fields: [callHandledById], references: [id])
  callHandledById String?
  caseOwner       Employee? @relation("CaseOwner", fields: [caseOwnerId], references: [id])
  caseOwnerId     String?
  analyst         Employee? @relation("QcAnalyst", fields: [analystId], references: [id])
  analystId       String?

  customerEscalation Boolean @default(false)

  callScore        Float // points earned on call-handling params
  callMax          Float // max points for applicable call-handling params
  callAdherence    Float? // percent, null when no applicable params
  caseScore        Float
  caseMax          Float
  caseAdherence    Float?
  overallScore     Float
  overallMax       Float
  overallAdherence Float?
  target           Float // pass threshold in percent (e.g. 95)
  passed           Boolean @default(false)

  findings   String?
  actionPlan String?
  period     String // YYYY-MM
  createdAt  DateTime @default(now())

  answers CallQcAnswer[]
}

// One answered parameter within an evaluation.
model CallQcAnswer {
  id           String           @id @default(cuid())
  evaluation   CallQcEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluationId String
  parameter    QcParameter      @relation(fields: [parameterId], references: [id])
  parameterId  String
  answer       String // YES | NO | NA
  comment      String?

  @@unique([evaluationId, parameterId])
}

model AppSetting {
  key       String   @id
  value     String // JSON blob
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("Team Member") // Admin | QA Lead | Call QA Analyst | Team Member
  employeeId   String?
  createdAt    DateTime @default(now())
}

model KTTemplate {
  id        String             @id @default(cuid())
  name      String
  team      String?
  createdAt DateTime           @default(now())
  topics    KTTemplateTopic[]
}

model KTTemplateTopic {
  id         String     @id @default(cuid())
  template   KTTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  topicName  String
}

// Data-driven navigation/section registry so sections can be reordered/renamed/toggled in-app.
model NavSection {
  id        String   @id @default(cuid())
  key       String   @unique // stable route/component key: dashboard, call-qa, ...
  label     String
  path      String
  icon      String // Lucide icon name
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  adminOnly Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A project whose new joinees need a standard set of accesses (CloudOps, VNA, PACS).
model Project {
  id          String       @id @default(cuid())
  key         String       @unique // CLOUDOPS | VNA | PACS
  name        String
  active      Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  accessItems AccessItem[]
}

// A standard access that belongs to a project's access list.
model AccessItem {
  id        String         @id @default(cuid())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int            @default(0)
  active    Boolean        @default(true)
  grants    JoineeAccess[]

  @@unique([projectId, name])
}

// Per-joinee provisioning status for a single access.
model JoineeAccess {
  id           String     @id @default(cuid())
  joinee       Joinee     @relation(fields: [joineeId], references: [id], onDelete: Cascade)
  joineeId     String
  accessItem   AccessItem @relation(fields: [accessItemId], references: [id], onDelete: Cascade)
  accessItemId String
  status       String     @default("Pending") // Pending | Granted | NA
  grantedDate  DateTime?
  notes        String?
  requestedBy  String?
  createdAt    DateTime   @default(now())

  @@unique([joineeId, accessItemId])
}
