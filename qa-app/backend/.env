# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000

# Jira Ticket QA scoring (scale + weights). timeliness + documentation weights should sum to 1.
QA_SCALE_MAX=5
QA_WEIGHT_TIMELINESS=0.5
QA_WEIGHT_DOCUMENTATION=0.5

# Call QA scoring (scale + weights). opening + info + deadAir + closing weights should sum to 1.
CALLQA_SCALE_MAX=5
CALLQA_WEIGHT_OPENING=0.25
CALLQA_WEIGHT_INFO=0.25
CALLQA_WEIGHT_DEADAIR=0.25
CALLQA_WEIGHT_CLOSING=0.25
# Time thresholds (seconds). Metrics above these are flagged as breached.
CALLQA_CASE_CREATION_THRESHOLD_SECS=120
CALLQA_CALL_CLOSE_THRESHOLD_SECS=60

# Downstream PMI application. If set, "Send to PMI" POSTs the report JSON here.
PMI_API_URL=
